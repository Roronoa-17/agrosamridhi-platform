# For LOCAL DEVELOPMENT ONLY. Copy this file to .env and fill in real
# values; .env is git-ignored. The EC2/production deployment does not
# use this file at all - it fetches DB_PASSWORD, JWT_SECRET,
# GEMINI_API_KEY, and AGMARKNET_API_KEY from AWS SSM Parameter Store at
# runtime instead (see docs/AWS_DEPLOYMENT.md, Phase 6).

# MySQL root password (used by agrosamridhi-db and every service's datasource)
DB_PASSWORD=rootpassword

# JWT signing secret shared by auth-service, api-gateway, and
# dashboard-aggregator-service. REQUIRED - docker compose refuses to start
# any of those services if this is unset, since falling back to a secret
# that's public in source control would let anyone forge a valid token.
JWT_SECRET=change_me_to_a_random_256_bit_secret

# Comma-separated origins allowed to call the API (auth-service AND
# api-gateway both read this - the gateway is what the browser actually talks
# to, so this must be the frontend's real origin in every environment).
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Google Gemini API key used by ai-inference-service
GEMINI_API_KEY=

# data.gov.in API key used by data-ingestion-service for Agmarknet mandi
# prices. Optional - falls back to data.gov.in's shared public sample key,
# which is rate-limited across all users of that key. Get your own free key
# at https://data.gov.in for reliable access.
AGMARKNET_API_KEY=

# Base URL the frontend bundle is built against (baked in at build time)
VITE_API_BASE_URL=http://localhost:8080
